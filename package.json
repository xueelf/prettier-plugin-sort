{
  "name": "prettier-plugin-sort",
  "version": "1.0.0",
  "description": "A Prettier plugin for sorting ES module imports, export specifiers, and package.json keys.",
  "keywords": [
    "imports",
    "order",
    "organize",
    "package.json",
    "plugin",
    "prettier",
    "prettier-plugin",
    "sort"
  ],
  "homepage": "https://github.com/xueelf/prettier-plugin-sort",
  "bugs": {
    "url": "https://github.com/xueelf/prettier-plugin-sort/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/prettier-plugin-sort.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{json,md,ts}\" --write --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.7.1",
    "annal": "^0.0.2",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "prettier": ">=3.9.0 <4"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
